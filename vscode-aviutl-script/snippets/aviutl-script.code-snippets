  },
  "obj.time": {
    "prefix": "time",
    "body": "obj.time",
    "description": "オブジェクトの開始フレームからの経過秒数(ReadOnly)"
  },
  "obj.totaltime": {
    "prefix": "totaltime",
    "body": "obj.totaltime",
    "description": "オブジェクトの開始フレームから終了フレームまでの総秒数(ReadOnly)"
  },
  "obj.totalframe": {
    "prefix": "totalframe",
    "body": "obj.totalframe",
    "description": "オブジェクトの開始フレームから終了フレームまでの総フレーム数(ReadOnly)"
  },
  "obj.index": {
    "prefix": "index",
    "body": "obj.index",
    "description": "複数オブジェクト時の番号。0 ≤ obj.index ≤ obj.num-1. (ReadOnly)"
  },
  "obj.num": {
    "prefix": "num",
    "body": "obj.num",
    "description": "複数オブジェクト時の数(1=単体オブジェクト/0=不定)。(ReadOnly)"
  },
  "obj.layer": {
    "prefix": "layer",
    "body": "obj.layer",
    "description": "オブジェクトが配置されているレイヤー"
  },
  "obj.x": {
