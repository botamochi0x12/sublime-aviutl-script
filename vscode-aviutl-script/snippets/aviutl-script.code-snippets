  "obj.frame": {
    "prefix": "frame",
    "body": "obj.frame",
    "description": "オブジェクトの開始フレームからの経過フレーム数(ReadOnly)"
  },
  "obj.framerate": {
    "prefix": "framerate",
    "body": "obj.framerate",
